+
+describe("godrays: godraysPassState (puerta por frame)", () => {
+  it("sol de frente lateral (no ocluido) -> visible con UV en [0,1]", () => {
+    const { vp, cam } = setup();
+    // Sol al frente-lateral: en frustum y sin la Tierra en medio (desde
+    // (0,0,3) el sol tras la Tierra se apaga por puerta de limbo, como manda).
+    const st = godraysPassState(vp, cam, vec3Normalize([0.5, 0.15, -1]));
+    expect(st.visible).toBe(true);
+    expect(st.sunUV[0] >= 0 && st.sunUV[0] <= 1 && st.sunUV[1] >= 0 && st.sunUV[1] <= 1).toBe(true);
+  });
+
+  it("sol detras o fuera o tras limbo -> apagado", () => {
+    const { vp, cam } = setup();
+    expect(godraysPassState(vp, cam, [0, 0, 1]).visible).toBe(false);
+    expect(godraysPassState(vp, cam, vec3Normalize([0.2, 3, -1])).visible).toBe(false);
+    // Camara mirando al sol con la Tierra en medio (limbo): el rayo
+    // camara->sol cruza la Tierra -> puerta por oclusion.
+    const limb = godraysPassState(vp, [0, 0, 3], vec3Normalize([-1, 0, -2.9]));
+    expect(limb.visible).toBe(false);
+  });
+});
diff --git a/src/lib/iono/godrays.ts b/src/lib/iono/godrays.ts
index c898c58..ed41854 100644
--- a/src/lib/iono/godrays.ts
+++ b/src/lib/iono/godrays.ts
@@ -165,3 +165,28 @@ export function tapUV(i: number, uv: Vec2, sunUV: Vec2, aspect: number): Vec2 {
 export function gateSkip(s: SunProj, sunBehindLimb: boolean): boolean {
   return s.behind || s.offscreen || sunBehindLimb;
 }
+
+export interface PassState {
+  /** false = pase apagado (puerta CPU). */
+  visible: boolean;
+  /** Sol en UV 0..1 (solo valido si visible). */
+  sunUV: [number, number];
+}
+
+/**
+ * Estado del pase por frame (P1-176): proyecta el sol visual (mismo vector
+ * que el sprite: motor-consistente con uSunDir), aplica la puerta CPU y
+ * devuelve el UV. El drape corregido no interviene: el pase trabaja en
+ * pantalla, no en datos. Puro.
+ */
+export function godraysPassState(
+  viewProj: Mat4,
+  camPos: Vec3,
+  sunDir: Vec3
+): PassState {
+  const s = projectSun(viewProj, camPos, sunDir);
+  const n = vec3Normalize(sunDir);
+  const behindLimb = rayHitsEarth(camPos, n);
+  if (gateSkip(s, behindLimb)) return { visible: false, sunUV: [0, 0] };
+  return { visible: true, sunUV: [s.x * 0.5 + 0.5, s.y * 0.5 + 0.5] };
+}

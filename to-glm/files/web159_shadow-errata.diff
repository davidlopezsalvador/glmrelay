diff --git a/src/lib/iono/volumeShadow.test.ts b/src/lib/iono/volumeShadow.test.ts
new file mode 100644
index 0000000..cdc7bc9
--- /dev/null
+++ b/src/lib/iono/volumeShadow.test.ts
@@ -0,0 +1,50 @@
+/**
+ * TU W-3 sombra (spec 158 sec.5.1, TU OBLIGATORIO): replica los pines del
+ * TU C++ (drop 133, tests/test_volume_shadow.cpp, norma 144). Vitest.
+ * Marco: sol en +X, esfera interior r = 1 + 60/6371 (60 km sobre r = 1).
+ */
+import { describe, expect, it } from "vitest";
+import { SHADOW_GUARD, shadowed } from "./volumeShadow";
+
+const LX = 1.0;
+const LY = 0.0;
+const LZ = 0.0;
+const K_INNER = 1.0 + 60.0 / 6371.0;
+
+describe("volume_shadow: casos estructurales", () => {
+  it("subsolar iluminado (el planeta queda detras)", () => {
+    expect(shadowed(1.05 * LX, 0, 0, LX, LY, LZ, K_INNER)).toBe(false);
+  });
+
+  it("antisolar en sombra (el rayo al sol cruza la esfera)", () => {
+    expect(shadowed(-1.05 * LX, 0, 0, LX, LY, LZ, K_INNER)).toBe(true);
+  });
+
+  it("limbo iluminado (rayo tangencial, sin interseccion)", () => {
+    expect(shadowed(0, 1.05, 0, LX, LY, LZ, K_INNER)).toBe(false);
+  });
+
+  it("frontera exacta t0==0 -> luz (la guarda protege el borde)", () => {
+    expect(shadowed(-K_INNER * LX, 0, 0, LX, LY, LZ, K_INNER)).toBe(false);
+  });
+
+  it("la guarda es 1e-4", () => {
+    expect(SHADOW_GUARD).toBe(1e-4);
+  });
+});
+
+describe("volume_shadow: monotonia dia->noche", () => {
+  it("una sola transicion luz->sombra en el ecuador solar", () => {
+    let flips = 0;
+    let prev = false;
+    let prevInit = false;
+    for (let i = 0; i <= 36; i++) {
+      const a = (i * Math.PI) / 36; // 0 = subsolar
+      const s = shadowed(1.05 * Math.cos(a), 1.05 * Math.sin(a), 0, LX, LY, LZ, K_INNER);
+      if (prevInit && s !== prev) flips++;
+      prev = s;
+      prevInit = true;
+    }
+    expect(flips).toBe(1);
+  });
+});
diff --git a/src/lib/iono/volumeShadow.ts b/src/lib/iono/volumeShadow.ts
new file mode 100644
index 0000000..cf20cc7
--- /dev/null
+++ b/src/lib/iono/volumeShadow.ts
@@ -0,0 +1,27 @@
+/**
+ * Sombra del planeta sobre el volumen W-3 (spec del veredicto 158, sec.5.1):
+ * espejo puro del test rayo-esfera del shader (drop 133,
+ * src/Utils/VolumeShadow.h). Misma matematica: si el rayo desde la muestra
+ * P hacia el sol cruza la esfera interior (radio innerR), la muestra esta
+ * en sombra dura. Guarda 1e-4 contra tangencias numericas (frontera = luz).
+ * Puro: sin DOM, sin three. El dimming cosChi se conserva y se combina
+ * multiplicativamente en el volumen (cuando exista el raymarch web).
+ */
+export const SHADOW_GUARD = 1e-4; // frontera = luz, como el gate 126
+
+/** true = en sombra (emision extinguida). L debe estar normalizada. */
+export function shadowed(
+  px: number,
+  py: number,
+  pz: number,
+  lx: number,
+  ly: number,
+  lz: number,
+  innerR: number
+): boolean {
+  const b = px * lx + py * ly + pz * lz;
+  const c = px * px + py * py + pz * pz - innerR * innerR;
+  const disc = b * b - c;
+  if (disc < 0) return false;
+  return -b - Math.sqrt(disc) > SHADOW_GUARD;
+}

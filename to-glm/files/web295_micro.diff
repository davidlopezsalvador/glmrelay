 } from "./voyager";
 
 // Respuesta REAL de Horizons el 2026-10-15 (forma pineada).
@@ -14,14 +15,29 @@ const HOR = ` Date__(UT)__HR:MN                delta      deldot
 
 describe("parseHorizons (forma JPL pineada)", () => {
   it("rango fresco (no el pin eterno del catalogo)", () => {
-    const f = parseHorizons(HOR);
-    expect(f).not.toBeNull();
-    expect(f!.au).toBeCloseTo(172.5293, 3);
-    expect(f!.au).toBeGreaterThan(172.48); // deriva real desde el 14-oct
-  });
-  it("basura -> null", () => {
-    expect(parseHorizons("")).toBeNull();
-    expect(parseHorizons("no data")).toBeNull();
+    const rows = parseHorizons(HOR);
+    expect(rows).toHaveLength(2);
+    expect(rows[1].au).toBeCloseTo(172.5293, 3);
+    expect(rows[1].au).toBeGreaterThan(172.48); // deriva real desde el 14-oct
+    expect(rows[0].t).toBeLessThan(rows[1].t);
+  });
+  it("basura -> []", () => {
+    expect(parseHorizons("")).toEqual([]);
+    expect(parseHorizons("no data")).toEqual([]);
+  });
+});
+
+describe("pickCurrentRow (P1-286: nunca futura)", () => {
+  const rows = parseHorizons(HOR);
+  const t15 = Date.parse("15 Oct 2026 12:00 UTC");
+  const t16 = Date.parse("16 Oct 2026 12:00 UTC");
+  it("elige la pasada mas cercana", () => {
+    expect(pickCurrentRow(rows, t15)!.au).toBeCloseTo(172.5082, 3);
+    expect(pickCurrentRow(rows, t16)!.au).toBeCloseTo(172.5293, 3);
+  });
+  it("vacio -> null; todo futuro -> primera (declarado)", () => {
+    expect(pickCurrentRow([], t15)).toBeNull();
+    expect(pickCurrentRow(rows, Date.parse("14 Oct 2026 00:00 UTC"))!.au).toBeCloseTo(172.5082, 3);
   });
 });
 
diff --git a/src/lib/iono/voyager.ts b/src/lib/iono/voyager.ts
index 2bdcd78..1f81fc3 100644
--- a/src/lib/iono/voyager.ts
+++ b/src/lib/iono/voyager.ts
@@ -57,17 +57,33 @@ export function pulseLapse(lightSec: number, sweepMs = 10000): number {
 export interface VoyagerFix {
   au: number;
   date: string; // "2026-Oct-15 00:00"
+  t: number; // epoch ms de la fila
 }
 
 /** Parseo de la tabla observer Horizons (quantity 20 = range AU). */
-export function parseHorizons(text: string): VoyagerFix | null {
-  const rows: { date: string; au: number }[] = [];
+export function parseHorizons(text: string): VoyagerFix[] {
+  const rows: VoyagerFix[] = [];
   for (const ln of text.split("\n")) {
-    const m = ln.match(/^\s*(\d{4}-[A-Za-z]{3}-\d{2} \d{2}:\d{2})\s+([\d.]+)\s+[\d.\-+]+\s*$/);
+    const m = ln.match(/^\s*(\d{4})-([A-Za-z]{3})-(\d{2}) (\d{2}):(\d{2})\s+([\d.]+)\s+[\d.\-+]+\s*$/);
     if (!m) continue;
-    const au = parseFloat(m[2]);
-    if (Number.isFinite(au) && au > 100 && au < 200) rows.push({ date: m[1], au });
+    const au = parseFloat(m[6]);
+    if (!(Number.isFinite(au) && au > 100 && au < 200)) continue;
+    const t = Date.parse(`${m[2]} ${m[3]}, ${m[1]} ${m[4]}:${m[5]} UTC`);
+    if (!Number.isFinite(t)) continue;
+    rows.push({ date: `${m[1]}-${m[2]}-${m[3]} ${m[4]}:${m[5]}`, au, t });
   }
+  return rows;
+}
+
+/**
+ * P1-286: fila pasada MAS CERCANA a ahora (nunca futura; fallback
+ * declarado a la primera si todo es futuro).
+ */
+export function pickCurrentRow(rows: VoyagerFix[], nowMs: number): VoyagerFix | null {
   if (!rows.length) return null;
-  return rows[rows.length - 1];
+  let best: VoyagerFix | null = null;
+  for (const r of rows) {
+    if (r.t <= nowMs) best = r;
+  }
+  return best ?? rows[0];
 }

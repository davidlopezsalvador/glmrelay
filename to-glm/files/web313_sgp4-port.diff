new file mode 100644
index 0000000..5f2b77c
--- /dev/null
+++ b/src/app/api/egress/route.ts
@@ -0,0 +1,98 @@
+import { NextResponse } from "next/server";
+import { createHash } from "node:crypto";
+
+/**
+ * TEMPORARY (drop 313, F2b #10): egress probe, deploy-side.
+ * 312 §3: single GET, no UI, NO cache (live read), JSON with
+ * status/latency/sample PER ORIGIN for the three endpoints of the 311
+ * evidence (GP-TLE 25544 / GP-JSON stations / SatNOGS 25544).
+ * Voyager pattern: server-side fetch with timeout + X-Cache: miss as
+ * evidence. This file is DELETED by the shell drop that consumes its
+ * result (salvo indicación del operador).
+ * Path note: GLM suggested `_egress`, but underscore-prefixed folders
+ * are PRIVATE/unrouted in the App Router; hence the routable `egress`.
+ */
+
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+export const maxDuration = 60;
+
+const UA = "IonosphereLive3D-Web/1.0 (exploration demo)";
+const TIMEOUT_MS = 20_000;
+const SAMPLE_CHARS = 512;
+
+const TARGETS = [
+  {
+    id: "celestrak-gp-tle",
+    url: "https://celestrak.org/NORAD/elements/gp.php?CATNR=25544&FORMAT=TLE",
+  },
+  {
+    id: "celestrak-gp-json",
+    url: "https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=JSON",
+  },
+  {
+    id: "satnogs-satellite",
+    url: "https://db.satnogs.org/api/satellites/?norad_cat_id=25544",
+  },
+] as const;
+
+interface OriginResult {
+  id: string;
+  url: string;
+  status: number | null;
+  latencyMs: number;
+  bytes: number;
+  contentType: string | null;
+  sha256: string | null;
+  sample: string;
+  error: string | null;
+}
+
+async function probe(id: string, url: string): Promise<OriginResult> {
+  const t0 = Date.now();
+  const out: OriginResult = {
+    id,
+    url,
+    status: null,
+    latencyMs: 0,
+    bytes: 0,
+    contentType: null,
+    sha256: null,
+    sample: "",
+    error: null,
+  };
+  try {
+    const ctrl = new AbortController();
+    const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
+    const res = await fetch(url, {
+      headers: { "User-Agent": UA, Accept: "*/*" },
+      signal: ctrl.signal,
+      cache: "no-store",
+      next: { revalidate: 0 },
+    });
+    clearTimeout(timer);
+    const body = await res.text();
+    out.status = res.status;
+    out.contentType = res.headers.get("content-type");
+    out.bytes = Buffer.byteLength(body, "utf8");
+    out.sha256 = createHash("sha256").update(body, "utf8").digest("hex");
+    out.sample = body.slice(0, SAMPLE_CHARS);
+  } catch (e) {
+    out.error = e instanceof Error ? `${e.name}: ${e.message}` : String(e);
+  }
+  out.latencyMs = Date.now() - t0;
+  return out;
+}
+
+export async function GET() {
+  const at = new Date().toISOString();
+  const targets = await Promise.all(TARGETS.map((t) => probe(t.id, t.url)));
+  return NextResponse.json(
+    {
+      at,
+      note: "temporary egress probe (drop 313); raw outputs are adjudicated in 314",
+      targets,
+    },
+    { headers: { "Cache-Control": "no-store", "X-Cache": "miss" } },
+  );
+}

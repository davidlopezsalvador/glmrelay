+        xnddt =
+          d2201 * Math.cos(x2omi + xli - g22) + d2211 * Math.cos(xli - g22) +
+          d3210 * Math.cos(xomi + xli - g32) + d3222 * Math.cos(-xomi + xli - g32) +

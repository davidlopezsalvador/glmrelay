+    ecco: 0, argpo: 0, mo: 0, noKozai: 0,
+    classification: "", intldesg: "",
+    ephtype: 0, elnum: 0, revnum: 0,
+    noUnkozai: 0,
+    am: 0, em: 0, im: 0, Om: 0, om: 0, mm: 0, nm: 0,
+    tumin: 0, mus: 0, radiusearthkm: 0, xke: 0,
+    j2: 0, j3: 0, j4: 0, j3oj2: 0,

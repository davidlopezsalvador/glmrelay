+/** Vista minima de estacion web para el mapeo (null = ausente). */
+export interface StationLike {
+  lat: number;
+  lon: number;
+  foE: number | null;
+  foF1: number | null;
+  foF2: number | null;
+  hmF2: number | null;
+  B0: number | null;
+  B1: number | null;
+}
+
+/**
+ * Mapeo estacion web -> ProfileSample (P1-170): copia de campos con
+ * null/ausente -> 0; las puertas >0 de interpProfiles convierten el 0 en
+ * fondo/mediana (exactamente como el C++ con dato ausente). IonosondeStation
+ * es asignable a StationLike.
+ */
+export function stationToProfileSample(s: StationLike): ProfileSample {
+  return {
+    latDeg: s.lat,
+    lonDeg: s.lon,
+    foE: s.foE ?? 0,
+    foF1: s.foF1 ?? 0,
+    foF2: s.foF2 ?? 0,
+    hmF2: s.hmF2 ?? 0,
+    B0: s.B0 ?? 0,
+    B1: s.B1 ?? 0,
+    valid: s.foF2 != null,
+    stale: false,
+  };
+}

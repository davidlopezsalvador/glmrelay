+import { NextResponse } from "next/server";
+import { parseKyotoAe, aeFileName } from "@/lib/iono/electrojets";
+
+/**
+ * W-4 F2a #17: AE realtime de Kyoto WDC (digital desde dic-2024).
+ * Patron MENSUAL fijado por este drop (O17):
+ *   https://wdc.kugi.kyoto-u.ac.jp/ae_realtime/data_dir/YYYY/MM/DD/aeYYMMDD
+ * Se traen hoy + ayer (~19 KB, TTL 15 min). Uso no-comercial + cita
+ * obligatoria: atribucion visible en el panel.
+ */
+
+export const revalidate = 0;
+
+const UA = "IonosphereLive3D-Web/1.0 (exploration demo)";
+const BASE = "https://wdc.kugi.kyoto-u.ac.jp/ae_realtime/data_dir";
+const TTL = 900_000;
+
+let cached: { data: unknown; ts: number } | null = null;
+
+async function fetchText(url: string): Promise<string | null> {
+  try {
+    const ctrl = new AbortController();
+    const timer = setTimeout(() => ctrl.abort(), 20000);
+    const res = await fetch(url, {
+      headers: { "User-Agent": UA },
+      signal: ctrl.signal,
+      next: { revalidate: 0 },
+    });
+    clearTimeout(timer);
+    if (!res.ok) return null;
+    return await res.text();
+  } catch {
+    return null;
+  }
+}
+
+export async function GET() {
+  if (cached && Date.now() - cached.ts < TTL) {
+    return NextResponse.json(cached.data, { headers: { "Cache-Control": "no-store", "X-Cache": "hit" } });
+  }
+  const now = Date.now();
+  const days: { y: number; m: number; d: number }[] = [];
+  for (let k = 0; k < 2; k++) {
+    const dt = new Date(now - k * 86400_000);
+    days.push({ y: dt.getUTCFullYear(), m: dt.getUTCMonth() + 1, d: dt.getUTCDate() });
+  }
+  const texts = await Promise.all(
+    days.map((dd) => {
+      const mm = String(dd.m).padStart(2, "0");
+      const dd2 = String(dd.d).padStart(2, "0");
+      return fetchText(`${BASE}/${dd.y}/${mm}/${dd2}/${aeFileName(dd.y, dd.m, dd.d)}`);
+    })
+  );
+  let pts: { t: number; ae: number }[] = [];
+  texts.forEach((t, i) => {
+    if (t) pts = pts.concat(parseKyotoAe(t, days[i].y, days[i].m, days[i].d));
+  });
+  pts.sort((a, b) => a.t - b.t);
+  // Ultimas 24 h a 5 min para el sparkline + valor actual + maximo.
+  const cut = now - 24 * 3600_000;
+  const win = pts.filter((p) => p.t >= cut && p.t <= now);
+  const series: { t: number; ae: number }[] = [];
+  for (let i = 0; i < win.length; i += 5) series.push(win[i]);
+  const live = win.length > 0;
+  const latest = live ? win[win.length - 1].ae : 0;
+  const max = live ? Math.max(...win.map((p) => p.ae)) : 0;
+  const payload = {
+    now: latest,
+    max24h: max,
+    series,
+    count: win.length,
+    checkedAt: now,
+    source: live ? "Kyoto WDC AE realtime (live)" : "unavailable",
+  };
+  cached = { data: payload, ts: now };
+  return NextResponse.json(payload, { headers: { "Cache-Control": "no-store", "X-Cache": "miss" } });
+}

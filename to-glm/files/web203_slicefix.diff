From t <t@t> Mon Oct 12 00:00:00 2026 +0200
From: t <t@t>
Date: Mon, 12 Oct 2026 00:00:00 +0200
Subject: [PATCH] w203-slicefix (paleta 0..1 a byte)

---
 {a => b}/src/lib/iono/slice.test.ts | 11 +++++++++++
 {a => b}/src/lib/iono/slice.ts      |  7 ++++---
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/lib/iono/slice.test.ts b/src/lib/iono/slice.test.ts
index 078d796..cfe3fa4 100644
--- a/src/lib/iono/slice.test.ts
+++ b/src/lib/iono/slice.test.ts
@@ -86,6 +86,17 @@ describe("slice: rejilla y muestreo", () => {
     const bot = 3;
     expect(g!.rgba[bot]).toBeLessThan(30);
   });
+  it("paleta 0..1 -> byte: arriba viridis brillante, abajo oscuro", () => {
+    const g = buildSliceGrid(rampVolume(), ep, 0);
+    const top = ((SLICE_LVL - 1) * SLICE_SEG + 0) * 4;
+    // viridis d=1 ~ (253,231,37): R alto (no negro truncado).
+    expect(g!.rgba[top]).toBeGreaterThan(200);
+    expect(g!.rgba[top + 1]).toBeGreaterThan(150);
+    const bot0 = 0;
+    // viridis d=0 ~ (68,1,84): oscuro pero no cero.
+    expect(g!.rgba[bot0]).toBeGreaterThan(0);
+    expect(g!.rgba[bot0]).toBeLessThan(120);
+  });
   it("posiciones: 64x20 xyz, radio exagerado", () => {
     const p = slicePositions(ep, 2.2);
     expect(p.length).toBe(SLICE_SEG * SLICE_LVL * 3);
diff --git a/src/lib/iono/slice.ts b/src/lib/iono/slice.ts
index e7546e9..11d4def 100644
--- a/src/lib/iono/slice.ts
+++ b/src/lib/iono/slice.ts
@@ -103,9 +103,10 @@ export function buildSliceGrid(
       if (d > peak) peak = d;
       const pi = Math.min(255, Math.max(0, Math.round(d * 255)));
       const o = (j * SLICE_SEG + i) * 4;
-      rgba[o] = pal[pi * 3];
-      rgba[o + 1] = pal[pi * 3 + 1];
-      rgba[o + 2] = pal[pi * 3 + 2];
+      // buildPalette devuelve 0..1 (stops float): a byte 0..255.
+      rgba[o] = Math.min(255, Math.max(0, Math.round(pal[pi * 3] * 255)));
+      rgba[o + 1] = Math.min(255, Math.max(0, Math.round(pal[pi * 3 + 1] * 255)));
+      rgba[o + 2] = Math.min(255, Math.max(0, Math.round(pal[pi * 3 + 2] * 255)));
       rgba[o + 3] = Math.min(255, Math.round(d * 1.2 * 255));
     }
   }

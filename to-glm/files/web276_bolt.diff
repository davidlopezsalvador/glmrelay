+
+describe("whistlerPath (linea de campo REAL de B(r))", () => {
+  it("la linea pasa por el punto y su conjugado", () => {
+    const pts = whistlerPath(33.9, -99.5);
+    expect(pts.length).toBeGreaterThan(10);

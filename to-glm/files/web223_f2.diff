@@ -14,6 +14,7 @@ import {
   VOL_LOG_RANGE,
   VOL_LON_RES,
   VOL_PEAK_FLOOR,
+  CHAPMAN_WINNER_COLORS,
   applyDayNight,
   densityDir,
   extractPeakGrids,
@@ -21,6 +22,8 @@ import {
   sampleVolume,
   volumeAltKm,

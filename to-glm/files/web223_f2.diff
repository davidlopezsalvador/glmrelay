   type DensityVolume,
 } from "./densityVolume";
 
@@ -186,3 +189,25 @@ describe("densityVolume: integrateTEC y sampleVolume", () => {
     expect(sampleVolume(blankVolume(), 0, 0, 200)).toBe(0);
   });
 });
+
+describe("densityVolume: params de render F2 (VolumeRenderer.h:31-37)", () => {
+  it("modo density->0, chapman->1", () => {
+    expect(volumeModeIndex("density")).toBe(0);
+    expect(volumeModeIndex("chapman")).toBe(1);
+  });
+  it("opacidad clamp [0,3]", () => {
+    expect(volumeOpacityClamp(-1)).toBe(0);
+    expect(volumeOpacityClamp(0)).toBe(0);
+    expect(volumeOpacityClamp(1)).toBe(1);
+    expect(volumeOpacityClamp(2.5)).toBe(2.5);
+    expect(volumeOpacityClamp(9)).toBe(3);
+  });
+  it("colores Chapman == VOL_FRAG (D/E/F1/F2)", () => {
+    expect(CHAPMAN_WINNER_COLORS).toEqual([
+      [1.0, 0.55, 0.1],
+      [0.2, 0.85, 0.3],
+      [1.0, 0.9, 0.2],
+      [0.2, 0.8, 1.0],
+    ]);
+  });
+});
diff --git a/src/lib/iono/densityVolume.ts b/src/lib/iono/densityVolume.ts
index 1d91668..63c16fd 100644
--- a/src/lib/iono/densityVolume.ts
+++ b/src/lib/iono/densityVolume.ts
@@ -231,3 +231,30 @@ export function sampleVolume(v: DensityVolume, latDeg: number, lonDeg: number, a
     at(x0 + 1, y0 + 1, a1) * fx * fy;
   return lo * (1 - fa) + hi * fa;
 }
+
+// ---------------------------------------------------------------------------
+// W-4 F2: parámetros de render del volumen (espejo VolumeRenderer.h:31-37
+// + App.cpp:4219-4227: Combo Density/Chapman + escala de opacidad).
+// Colores ganadores D/E/F1/F2 byte-iguales a la rama Chapman de VOL_FRAG
+// (pin anti-deriva: el shader los lleva hardcodeados). TU: densityVolume.
+// ---------------------------------------------------------------------------
+
+/** Ganadores D/E/F1/F2 (mirror VOL_FRAG u_colorMode==1). */
+export const CHAPMAN_WINNER_COLORS: readonly (readonly [number, number, number])[] = [
+  [1.0, 0.55, 0.1],
+  [0.2, 0.85, 0.3],
+  [1.0, 0.9, 0.2],
+  [0.2, 0.8, 1.0],
+] as const;
+
+/** density->0, chapman->1 (u_colorMode). */
+export function volumeModeIndex(mode: "density" | "chapman"): 0 | 1 {
+  return mode === "chapman" ? 1 : 0;
+}
+
+/** Clamp [0,3] (setOpacityScale, VolumeRenderer.h:37). */
+export function volumeOpacityClamp(v: number): number {
+  if (!(v > 0)) return 0;
+  if (v > 3) return 3;
+  return v;
+}

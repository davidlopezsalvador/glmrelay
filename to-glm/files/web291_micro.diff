+describe("selectMagSource (P1-284: feed descendente multi-nave)", () => {
+  // Feed como el real: descendente, SOLAR1 activa + ACE inactiva.
+  const T = 1_000_000_000;
+  const rows = [
+    { t: T + 300, bx: -9, active: false }, // ACE nueva (inactiva)
+    { t: T + 300, bx: 4.4, active: true }, // SOLAR1 nueva
+    { t: T + 200, bx: -8, active: false },
+    { t: T + 200, bx: 4.5, active: true },
+    { t: T + 100, bx: null, active: true },
+  ];
+  it("solo fuente activa, ascendente, Bx del extremo nuevo", () => {
+    const s = selectMagSource(rows, 3, T + 400);
+    expect(s).toHaveLength(2);
+    expect(s[0]).toEqual({ t: T + 200, bx: 4.5 });
+    expect(s[1]).toEqual({ t: T + 300, bx: 4.4 });
+    expect(findCrossings(s)).toEqual([]); // sin mezcla no hay cruces falsos
+  });
+  it("fallback a todas si ninguna activa (declarado)", () => {
+    const dead = rows.map((r) => ({ ...r, active: false }));
+    expect(selectMagSource(dead, 3, T + 400)).toHaveLength(4);
+  });
+});
diff --git a/src/lib/iono/parker.ts b/src/lib/iono/parker.ts
index 794dae1..6c47c30 100644
--- a/src/lib/iono/parker.ts
+++ b/src/lib/iono/parker.ts
@@ -60,6 +60,31 @@ export interface MagPt {
   bx: number;
 }
 
+export interface MagRow {
+  t: number;
+  bx: number | null;
+  active: boolean;
+}
+
+/**
+ * P1-284: el feed rtsw es DESCENDENTE y MULTI-NAVE (SOLAR1 activa +
+ * ACE/IMAP inactivas intercaladas). Selección honesta: filas de la
+ * fuente ACTIVA (fallback declarado a todas si ninguna lo es),
+ * ordenadas ASCENDENTES (la más nueva al final). De aquí salen tanto
+ * el Bx vigente (extremo nuevo) como la serie de cruces (con la
+ * serie ascendente de una sola fuente, recent[last] ya es el cruce
+ * más nuevo — el síntoma (c) se corrige solo).
+ */
+export function selectMagSource(rows: MagRow[], hoursBack = 3, nowMs = Date.now()): MagPt[] {
+  const act = rows.filter((r) => r.active);
+  const pool = act.length ? act : rows;
+  const cut = nowMs - hoursBack * 3600_000;
+  return pool
+    .filter((r) => r.bx != null && r.t >= cut)
+    .map((r) => ({ t: r.t, bx: r.bx as number }))
+    .sort((a, b) => a.t - b.t);
+}
+
 /** Cruces de sector CALCULADOS del dato (cambios de signo adyacentes). */

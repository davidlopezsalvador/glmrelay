From 4fa4956aa8e954ac0afbba0638f09cba6dd07a29 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Thu, 8 Oct 2026 00:50:46 +0200
Subject: [PATCH] w185

---
 src/components/ionosphere/builders.ts | 7 +++++--
 src/components/ionosphere/shaders.ts  | 2 +-
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/components/ionosphere/builders.ts b/src/components/ionosphere/builders.ts
index 211ae2a..0c78d41 100644
--- a/src/components/ionosphere/builders.ts
+++ b/src/components/ionosphere/builders.ts
@@ -490,7 +490,9 @@ export function buildVolumeMesh(cmapTex: THREE.Texture) {
     },
     vertexShader: VOL_VERT,
     fragmentShader: VOL_FRAG,
-    glslVersion: THREE.GLSL3,
+    // SIN glslVersion: three emite #version 300 es con defines de compat
+    // (gl_FragColor/varying/texture2D) en WebGL2 -- con THREE.GLSL3 el shader
+    // no compilaria (n1-184: gl_FragColor no definido + vec3-int).
     transparent: true,
     depthWrite: false,
     side: THREE.BackSide,
@@ -541,8 +543,9 @@ export function updateVolumeTextures(
   }
   const dd = densityTex.image.data as Uint8Array;
   for (let i = 0; i < vol.data.length; i++) {
+    // P3-184: truncado como el (unsigned char) del oraculo (no round).
     const v = vol.data[i];
-    dd[i] = Math.max(0, Math.min(255, Math.round((v < 0 ? 0 : v > 1 ? 1 : v) * 255)));
+    dd[i] = Math.max(0, Math.min(255, Math.trunc((v < 0 ? 0 : v > 1 ? 1 : v) * 255)));
   }
   densityTex.needsUpdate = true;
   if (vol.layer.length === vol.data.length) {
diff --git a/src/components/ionosphere/shaders.ts b/src/components/ionosphere/shaders.ts
index 5b99890..f51c22a 100644
--- a/src/components/ionosphere/shaders.ts
+++ b/src/components/ionosphere/shaders.ts
@@ -633,7 +633,7 @@ void main() {
       ivec3 ip = ivec3(clamp(vec3(floor(uv.x * float(u_volRes.x)),
                                            floor(uv.y * float(u_volRes.y)),
                                            floor(altNorm * float(u_volRes.z))),
-                                   vec3(0.0), vec3(u_volRes) - 1));
+                                   vec3(0.0), vec3(u_volRes) - 1.0));
       int w = int(texelFetch(u_layer, ip, 0).r * 255.0 + 0.5);
       if (w == 0)      col = vec3(1.00, 0.55, 0.10);
       else if (w == 1) col = vec3(0.20, 0.85, 0.30);
-- 
